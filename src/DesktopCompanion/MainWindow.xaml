<Window x:Class="DesktopCompanion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktop Companion" SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ResizeMode="NoResize" ShowInTaskbar="True"
        KeyDown="Window_KeyDown">
  <Grid Margin="10">
    <Border x:Name="Card" Width="360" Background="{StaticResource CardBrush}" CornerRadius="12"
            BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
      <Border.Effect>
        <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.45" Color="Black"/>
      </Border.Effect>
      <StackPanel>
        <Grid x:Name="Header" Height="44" Background="Transparent" Margin="8,0,8,0"
              MouseLeftButtonDown="Header_MouseDown">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Button x:Name="MenuButton" Style="{StaticResource IconButton}" Content="&#xE700;" Click="Menu_Click" AutomationProperties.AutomationId="MenuButton"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
            <RadioButton x:Name="TabToday" Style="{StaticResource TabButton}" Tag="Today" IsChecked="True" Checked="Tab_Checked">
              <StackPanel Orientation="Horizontal">
                <TextBlock FontSize="11.5" Text="Today" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" VerticalAlignment="Center"/>
                <Border Background="{StaticResource SelectedBadgeBrush}" CornerRadius="4" Padding="5,1" Margin="6,0,0,0"><TextBlock x:Name="CountToday" FontSize="10"/></Border>
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="TabUpcoming" Style="{StaticResource TabButton}" Tag="Upcoming" Checked="Tab_Checked">
              <StackPanel Orientation="Horizontal">
                <TextBlock FontSize="11.5" Text="Upcoming" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" VerticalAlignment="Center"/>
                <Border Background="{StaticResource BadgeBrush}" CornerRadius="4" Padding="5,1" Margin="6,0,0,0"><TextBlock x:Name="CountUpcoming" FontSize="10"/></Border>
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="TabBacklog" Style="{StaticResource TabButton}" Tag="Backlog" Checked="Tab_Checked">
              <StackPanel Orientation="Horizontal">
                <TextBlock FontSize="11.5" Text="Backlog" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" VerticalAlignment="Center"/>
                <Border Background="{StaticResource BadgeBrush}" CornerRadius="4" Padding="5,1" Margin="6,0,0,0"><TextBlock x:Name="CountBacklog" FontSize="10"/></Border>
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="TabLater" Style="{StaticResource TabButton}" Tag="Later" Checked="Tab_Checked">
              <TextBlock FontSize="11.5" Text="Later" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" VerticalAlignment="Center"/>
            </RadioButton>
          </StackPanel>
          <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE710;" AutomationProperties.AutomationId="AddButton" Click="Add_Click"/>
        </Grid>

        <ScrollViewer x:Name="ListScroll" VerticalScrollBarVisibility="Hidden" MaxHeight="124" Margin="0,0,0,8">
          <ItemsControl x:Name="TaskList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border x:Name="row" Height="31" Margin="0,0,0,0" Background="Transparent"
                        BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="3"/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="32"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="{Binding Accent}" CornerRadius="0,2,2,0" Margin="0,3"/>
                    <CheckBox Grid.Column="1" Style="{StaticResource TaskCheck}" IsChecked="{Binding IsDone, Mode=TwoWay}" Margin="13,0,12,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="title" Grid.Column="2" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12.5"/>
                    <TextBlock x:Name="when" Grid.Column="3" Text="{Binding When}" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <TextBlock Grid.Column="4" Text="{Binding Icon}" Style="{StaticResource IconText}" Foreground="{StaticResource Muted2Brush}"/>
                  </Grid>
                </Border>
                <DataTemplate.Triggers>
                  <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="row" Property="Background" Value="{StaticResource HoverBrush}"/>
                  </Trigger>
                  <DataTrigger Binding="{Binding IsDone}" Value="True">
                    <Setter TargetName="title" Property="TextDecorations" Value="Strikethrough"/>
                    <Setter TargetName="title" Property="Foreground" Value="{StaticResource Muted2Brush}"/>
                    <Setter TargetName="title" Property="Opacity" Value="0.6"/>
                    <Setter TargetName="row" Property="Opacity" Value="0.7"/>
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </StackPanel>
    </Border>

    <Popup x:Name="MenuPopup" PlacementTarget="{Binding ElementName=Header}" Placement="Bottom"
           HorizontalOffset="8" VerticalOffset="-2" StaysOpen="False" AllowsTransparency="True">
      <Border Margin="8" Width="220" Background="{StaticResource CardBrush}" CornerRadius="10" Padding="6"
              BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
        <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.5"/></Border.Effect>
        <StackPanel>
          <Button Style="{StaticResource MenuRow}" Click="Add_Click">
            <Grid><TextBlock Text="&#xE710;" Style="{StaticResource IconText}" HorizontalAlignment="Left"/><TextBlock Text="Add task" Margin="28,0,0,0"/><TextBlock Text="Ctrl + N" Foreground="{StaticResource Muted2Brush}" FontSize="10.5" HorizontalAlignment="Right"/></Grid>
          </Button>
          <Button Style="{StaticResource MenuRow}" Click="AddNote_Click" AutomationProperties.AutomationId="AddNoteRow">
            <Grid><TextBlock Text="&#xE8A5;" Style="{StaticResource IconText}" HorizontalAlignment="Left"/><TextBlock Text="Add note" Margin="28,0,0,0"/><TextBlock Text="Ctrl + Alt + N" Foreground="{StaticResource Muted2Brush}" FontSize="10.5" HorizontalAlignment="Right"/></Grid>
          </Button>
          <Button Style="{StaticResource MenuRow}" Click="Notes_Click" AutomationProperties.AutomationId="NotesRow">
            <Grid><TextBlock Text="&#xE70B;" Style="{StaticResource IconText}" HorizontalAlignment="Left"/><TextBlock Text="Notes" Margin="28,0,0,0"/></Grid>
          </Button>
          <Button x:Name="ToggleViewRow" AutomationProperties.AutomationId="ToggleRow" Style="{StaticResource MenuRow}" Click="ToggleView_Click">
            <Grid><TextBlock Text="&#xE740;" Style="{StaticResource IconText}" HorizontalAlignment="Left"/><TextBlock x:Name="ToggleViewText" Text="Expanded view" Margin="28,0,0,0"/></Grid>
          </Button>
          <Border Height="1" Background="{StaticResource DividerBrush}" Margin="4,4"/>
          <Button Style="{StaticResource MenuRow}" Click="Stub_Click" Tag="Settings">
            <Grid><TextBlock Text="&#xE713;" Style="{StaticResource IconText}" HorizontalAlignment="Left"/><TextBlock Text="Settings" Margin="28,0,0,0"/></Grid>
          </Button>
          <Button Style="{StaticResource MenuRow}" Click="Stub_Click" Tag="Appearance">
            <Grid><TextBlock Text="&#xE790;" Style="{StaticResource IconText}" HorizontalAlignment="Left"/><TextBlock Text="Appearance" Margin="28,0,0,0"/></Grid>
          </Button>
          <Button Style="{StaticResource MenuRow}" Click="Stub_Click" Tag="Shortcuts">
            <Grid><TextBlock Text="&#xE765;" Style="{StaticResource IconText}" HorizontalAlignment="Left"/><TextBlock Text="Shortcuts" Margin="28,0,0,0"/></Grid>
          </Button>
          <Border Height="1" Background="{StaticResource DividerBrush}" Margin="4,4"/>
          <Button Style="{StaticResource MenuRow}" Click="Minimize_Click">
            <Grid><TextBlock Text="&#xE896;" Style="{StaticResource IconText}" HorizontalAlignment="Left"/><TextBlock Text="Minimize to tray" Margin="28,0,0,0"/></Grid>
          </Button>
          <Button Style="{StaticResource MenuRow}" Click="Minimize_Click">
            <Grid><TextBlock Text="&#xE711;" Style="{StaticResource IconText}" HorizontalAlignment="Left"/><TextBlock Text="Hide window" Margin="28,0,0,0"/><TextBlock Text="Ctrl + H" Foreground="{StaticResource Muted2Brush}" FontSize="10.5" HorizontalAlignment="Right"/></Grid>
          </Button>
          <Button Style="{StaticResource MenuRow}" Click="Quit_Click">
            <Grid><TextBlock Text="&#xE7E8;" Style="{StaticResource IconText}" HorizontalAlignment="Left"/><TextBlock Text="Quit" Margin="28,0,0,0"/></Grid>
          </Button>
        </StackPanel>
      </Border>
    </Popup>
  </Grid>
</Window>



