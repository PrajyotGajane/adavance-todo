<Window x:Class="DesktopCompanion.QuickAddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True"
        ShowInTaskbar="False" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        Deactivated="Window_Deactivated" PreviewKeyDown="Window_PreviewKeyDown">
  <Border Margin="12" Width="520" Height="56" Background="{StaticResource CardBrush}" CornerRadius="12"
          BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
    <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.55"/></Border.Effect>
    <Grid Margin="10,0,8,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Text="&#xE721;" Style="{StaticResource IconText}" FontSize="16" Foreground="{StaticResource TextBrush}" Margin="4,0,12,0"/>
      <Grid Grid.Column="1" VerticalAlignment="Center">
        <TextBlock x:Name="Hint" Text="Add a task, e.g. Call mom tomorrow 10am" Foreground="{StaticResource Muted2Brush}" FontSize="14" IsHitTestVisible="False"/>
        <TextBox x:Name="Input" AutomationProperties.AutomationId="QuickInput" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}"
                 CaretBrush="{StaticResource TextBrush}" FontFamily="Roboto, Segoe UI" FontSize="14"
                 TextChanged="Input_TextChanged"/>
      </Grid>
      <Border Grid.Column="2" Background="#1C2533" CornerRadius="4" Padding="7,3" Margin="8,0" VerticalAlignment="Center">
        <TextBlock Text="Tab to add details" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
      </Border>
      <Button Grid.Column="3" AutomationProperties.AutomationId="SubmitButton" Style="{StaticResource PrimaryButton}" Width="40" Height="40" Click="Submit_Click">
        <TextBlock Text="&#xE751;" Style="{StaticResource IconText}" Foreground="White" FontSize="16"/>
      </Button>
    </Grid>
  </Border>
</Window>

