<UserControl x:Class="DesktopCompanion.QuickAddView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             PreviewKeyDown="View_PreviewKeyDown">
  <StackPanel>
        <Grid Height="54" Margin="10,0,8,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="ModeIcon" Text="&#xE721;" Style="{StaticResource IconText}" FontSize="16" Foreground="{StaticResource TextBrush}" Margin="4,0,12,0"/>
          <Grid Grid.Column="1" VerticalAlignment="Center">
            <TextBlock x:Name="Hint" Text="Add a task, e.g. Call mom tomorrow 10am" Foreground="{StaticResource Muted2Brush}" FontSize="14" IsHitTestVisible="False"/>
            <TextBox x:Name="Input" AutomationProperties.AutomationId="QuickInput" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}"
                     CaretBrush="{StaticResource TextBrush}" FontFamily="Roboto, Segoe UI" FontSize="14"
                     TextChanged="Input_TextChanged"/>
          </Grid>
          <Border x:Name="TabHint" Grid.Column="2" Background="#1C2533" CornerRadius="4" Padding="7,3" Margin="8,0" VerticalAlignment="Center">
            <TextBlock Text="Tab to add details" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
          </Border>
          <Button Grid.Column="3" AutomationProperties.AutomationId="SubmitButton" Style="{StaticResource PrimaryButton}" Width="38" Height="38" Click="Submit_Click">
            <TextBlock Text="&#xE751;" Style="{StaticResource IconText}" Foreground="White" FontSize="16"/>
          </Button>
        </Grid>
        <Grid x:Name="Chips" Visibility="Collapsed" Margin="14,0,14,12">
          <StackPanel Orientation="Horizontal">
            <Border Background="#142F7C" CornerRadius="6" Padding="8,4" Margin="0,0,8,0">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE787;" Style="{StaticResource IconText}" FontSize="12"/><TextBlock x:Name="DateChip" AutomationProperties.AutomationId="DateChip" Margin="6,0,0,0" FontSize="11"/></StackPanel>
            </Border>
            <Border Background="#1C2533" CornerRadius="6" Padding="8,4" Margin="0,0,8,0">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE121;" Style="{StaticResource IconText}" FontSize="12"/><TextBlock x:Name="TimeChip" AutomationProperties.AutomationId="TimeChip" Margin="6,0,0,0" FontSize="11"/></StackPanel>
            </Border>
            <Border Background="#1C2533" CornerRadius="6" Padding="8,4">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8EC;" Style="{StaticResource IconText}" FontSize="12"/><TextBlock x:Name="TagChip" AutomationProperties.AutomationId="TagChip" Margin="6,0,0,0" FontSize="11"/></StackPanel>
            </Border>
          </StackPanel>
          <TextBlock x:Name="KeysHint" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource Muted2Brush}"
                     Text="Enter to add  -  Esc to cancel"/>
        </Grid>
      </StackPanel>
</UserControl>

