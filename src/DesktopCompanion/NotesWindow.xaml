<Window x:Class="DesktopCompanion.NotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True"
        ShowInTaskbar="False" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        PreviewKeyDown="Window_PreviewKeyDown">
  <Grid>
  <Border Margin="12" Width="560" Height="300" Background="{StaticResource CardBrush}" CornerRadius="12" IsHitTestVisible="False"><Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.5"/></Border.Effect></Border>
  <Border Margin="12" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" Width="560" Height="300" Background="{StaticResource CardBrush}" CornerRadius="12"
          BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" MouseLeftButtonDown="Drag">
    
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,1,0">
        <StackPanel Margin="8,10">
          <Button Style="{StaticResource MenuRow}" Click="Tasks_Click">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE73E;" Style="{StaticResource IconText}"/><TextBlock Text="Tasks" Margin="12,0,0,0" FontSize="13"/></StackPanel>
          </Button>
          <Border Background="#131C28" CornerRadius="6" Height="30" Padding="10,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="&#xE70B;" Style="{StaticResource IconText}"/><TextBlock Text="Notes" Margin="12,0,0,0" FontSize="13"/></StackPanel>
          </Border>
          <Button Style="{StaticResource MenuRow}" Click="Close_Click">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" Style="{StaticResource IconText}"/><TextBlock Text="Close" Margin="12,0,0,0" FontSize="13"/></StackPanel>
          </Button>
        </StackPanel>
      </Border>
      <Grid Grid.Column="1" Margin="16,12,16,8">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="Notes" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <Border Grid.Row="1" Height="32" Margin="0,10,0,6" CornerRadius="6" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Background="#0B1018">
          <Grid Margin="8,0">
            <TextBlock Text="&#xE721;" Style="{StaticResource IconText}" HorizontalAlignment="Left"/>
            <TextBlock x:Name="SearchHint" Text="Search notes..." Foreground="{StaticResource Muted2Brush}" Margin="26,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            <TextBox x:Name="Search" Margin="26,0,0,0" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center"
                     Foreground="{StaticResource TextBrush}" CaretBrush="{StaticResource TextBrush}" TextChanged="Search_TextChanged"/>
          </Grid>
        </Border>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Hidden">
          <ItemsControl x:Name="NoteList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Height="52">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="3"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border Background="{Binding Accent}" CornerRadius="2" Margin="0,8"/>
                  <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="13"/>
                    <TextBlock Text="{Binding Preview}" Foreground="{StaticResource Muted2Brush}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding When}" Foreground="{StaticResource Muted2Brush}" FontSize="11" VerticalAlignment="Center"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Border>
</Grid>
</Window>

