<UserControl x:Class="DesktopCompanion.NotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid x:Name="ListView" Margin="14,2,14,8">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border Height="32" Margin="0,4,0,6" CornerRadius="6" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Background="#0B1018">
        <Grid Margin="8,0">
          <TextBlock Text="&#xE721;" Style="{StaticResource IconText}" HorizontalAlignment="Left"/>
          <TextBlock x:Name="SearchHint" Text="Search notes..." Foreground="{StaticResource Muted2Brush}" Margin="26,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
          <TextBox x:Name="Search" AutomationProperties.AutomationId="NoteSearch" Margin="26,0,0,0" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center"
                   Foreground="{StaticResource TextBrush}" CaretBrush="{StaticResource TextBrush}" TextChanged="Search_TextChanged"/>
        </Grid>
      </Border>
      <Grid Grid.Row="1">
        <ListBox x:Name="NoteList" Style="{StaticResource PlainList}" AutomationProperties.AutomationId="NoteList" MouseLeftButtonUp="NoteList_Click">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Height="52">
                <Grid.ColumnDefinitions><ColumnDefinition Width="3"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Background="{Binding Accent}" CornerRadius="2" Margin="0,8"/>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding Preview}" Foreground="{StaticResource Muted2Brush}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding When}" Foreground="{StaticResource Muted2Brush}" FontSize="11" VerticalAlignment="Center" Margin="8,0,8,0"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="EmptyText" Text="No notes yet. Press Ctrl+N to write one." Foreground="{StaticResource Muted2Brush}" FontSize="11.5"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
      </Grid>
      <TextBlock Grid.Row="2" Text="Type to search  -  Up/Down  -  Enter open  -  Del delete  -  Ctrl+N new  -  Esc back" FontSize="10" Foreground="{StaticResource Muted2Brush}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
    </Grid>

    <Grid x:Name="EditView" Margin="14,2,14,8" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid>
        <Button Style="{StaticResource IconButton}" Content="&#xE72B;" HorizontalAlignment="Left" Click="Back_Click" ToolTip="Back (Esc)" AutomationProperties.AutomationId="NoteBack"/>
        <TextBlock x:Name="EditTitle" Text="Edit note" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="36,0,0,0"/>
        <Button Style="{StaticResource IconButton}" Content="&#xE74D;" HorizontalAlignment="Right" Click="Delete_Click" ToolTip="Delete (Ctrl + D)"/>
      </Grid>
      <TextBox x:Name="Editor" Grid.Row="1" AutomationProperties.AutomationId="NoteEditor" Margin="0,10,0,0" Background="Transparent" BorderThickness="0" AcceptsReturn="True" TextWrapping="Wrap"
               VerticalScrollBarVisibility="Hidden" Foreground="{StaticResource TextBrush}" CaretBrush="{StaticResource AccentBrush}" FontFamily="Roboto, Segoe UI" FontSize="13" Padding="0"/>
      <TextBlock Grid.Row="2" Text="Esc save and go back  -  Ctrl+S save  -  Ctrl+D delete" FontSize="10" Foreground="{StaticResource Muted2Brush}" Margin="0,6,0,0"/>
    </Grid>
  </Grid>
</UserControl>
