<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="CardColor">#0D131B</Color>
  <SolidColorBrush x:Key="CardBrush" Color="#0D131B"/>
  <SolidColorBrush x:Key="CardBorderBrush" Color="#232D3C"/>
  <SolidColorBrush x:Key="TextBrush" Color="#F4F6FF"/>
  <SolidColorBrush x:Key="MutedBrush" Color="#B5C8EB"/>
  <SolidColorBrush x:Key="Muted2Brush" Color="#A2B6D6"/>
  <SolidColorBrush x:Key="DividerBrush" Color="#1B2430"/>
  <SolidColorBrush x:Key="HoverBrush" Color="#151A21"/>
  <SolidColorBrush x:Key="SelectedTabBrush" Color="#142F7C"/>
  <SolidColorBrush x:Key="SelectedBadgeBrush" Color="#111C37"/>
  <SolidColorBrush x:Key="BadgeBrush" Color="#232D3C"/>
  <SolidColorBrush x:Key="AccentBrush" Color="#3C76FF"/>
  <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>

  <Style TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Roboto, Segoe UI"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="FontSize" Value="12"/>
  </Style>

  <Style x:Key="IconText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style x:Key="IconButton" TargetType="Button">
    <Setter Property="Width" Value="28"/>
    <Setter Property="Height" Value="28"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="Transparent" CornerRadius="6">
            <TextBlock Text="{TemplateBinding Content}" Style="{StaticResource IconText}"
                       Foreground="{TemplateBinding Foreground}" FontSize="16"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#1C2533"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="TabButton" TargetType="RadioButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
    <Setter Property="Margin" Value="0,0,1,0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="7,0" Height="26">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#151D29"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource SelectedTabBrush}"/>
              <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="TaskCheck" TargetType="CheckBox">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Border x:Name="bd" Width="16" Height="16" CornerRadius="3" BorderThickness="1.5"
                  BorderBrush="{StaticResource Muted2Brush}" Background="Transparent">
            <TextBlock x:Name="tick" Text="&#xE73E;" Style="{StaticResource IconText}" FontSize="10"
                       Foreground="White" Visibility="Collapsed"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentBrush}"/>
              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
              <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="MenuRow" TargetType="Button">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="Transparent" CornerRadius="6" Height="30" Padding="10,0">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#1C2533"/>
            </Trigger>
            <Trigger Property="Tag" Value="sel">
              <Setter TargetName="bd" Property="Background" Value="#1C2533"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PrimaryButton" TargetType="Button">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{StaticResource AccentBrush}" CornerRadius="6" Padding="12,0">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#5A8BFF"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <SolidColorBrush x:Key="HoverTabBrush" Color="#1B2A52"/>
  <SolidColorBrush x:Key="SelectedRowBrush" Color="#16213A"/>

  <Style x:Key="RowItem" TargetType="ListBoxItem">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="bd" Background="Transparent">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource SelectedRowBrush}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PlainList" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="ItemContainerStyle" Value="{StaticResource RowItem}"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden"/>
  </Style>
</ResourceDictionary>
